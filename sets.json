[{"chinese": "\u4e0b\u5217\u8bf4\u6cd5\u6b63\u786e\u7684\u662f", "english": "Which of the following statements is correct?", "options": ["A. -2 \u2208 N", "B. \u03c0 \u2208 Q", "C. 3/2 \u2208 Z", "D. \u221a3 \u2208 R"], "answer": "D", "topic": "sets", "type": "oct", "n": 1}, {"chinese": "\u82e5\u96c6\u5408 A = {1, 2}\uff0cB = {1, 2, 3}\uff0c\u5219\u4ee5\u4e0b\u54ea\u4e2a\u662f\u6b63\u786e\u7684\uff1f", "english": "If the set A = {1, 2} and B = {1, 2, 3}, then which of the following is true?", "options": ["A. 1 \u2208 B \\ A", "B. 3 \u2208 B \\ A", "C. 3 \u2208 A \\ B", "D. 1 \u2208 A \\ B"], "answer": "B", "topic": "sets"}, {"chinese": "\u82e5\u96c6\u5408 A = {1, 2}\uff0cB = {1, 2, 3}\uff0c\u5219\u4ee5\u4e0b\u54ea\u4e2a\u662f\u6b63\u786e\u7684\uff1f", "english": "If the set A = {1, 2} and B = {1, 2, 3}, then which of the following is true?", "options": ["A. A \u2282 A ", "B. A = B", "C. A \u2286 B", "D. A \u2284 B"], "answer": "C", "topic": "sets"}, {"chinese": "\u8bbe A={a\u2208Z \u2223 \u22122<a<3}\uff0cB={\u5076\u6570}\u3002\u90a3\u4e48 A\u2229B \u4e2d\u7684\u5143\u7d20\u662f\u4ec0\u4e48\uff1f", "english": "Let A={a\u2208Z \u2223 \u22122<a<3} and B={even integers}. Which element belongs to  A\u2229B?", "options": ["A. -1", "B. 0", "C. 3", "D. 4"], "answer": "B", "link": "https://t.me/c/3305923058/19", "topic": "sets"}, {"chinese": "\u82e5\u96c6\u5408 A = (-1, 3)\uff0cB = [2, 4]\uff0c\u5219 A \u2229 B = \u4ec0\u4e48\uff1f", "english": "If the set A = (-1, 3) and B = [2, 4], then what is A \u2229 B?", "options": ["A. [2, 3]", "B. [2, 3)", "C. (2, 3]", "D. (2, 3)"], "answer": "B", "topic": "sets", "link": "https://t.me/c/3305923058/32", "type": "dec", "n": 2}, {"chinese": "\u82e5\u96c6\u5408 A = (1, 10)\uff0cB = [-7, 4]\uff0c\u5219 A U B = \u4ec0\u4e48\uff1f", "english": "If the set A = (1, 10)  and B = B = [-7, 4], then what is A U B?", "options": ["A. [-7, 10]", "B. (1, 4]", "C. [-7, 10)", "D. (1, 4)"], "answer": "C", "topic": "sets", "link": "https://t.me/c/3305923058/32"}, {"chinese": "\u5982\u679c A\u2282B\uff0c\u90a3\u4e48\u54ea\u4e2a\u8bed\u53e5\u603b\u662f\u6b63\u786e\u7684\uff1f", "english": "If A\u2282B, which statement is always true?", "options": ["A. A\u222aB=A", "B. A\u2229B=B", "C. A\u222aB=B", "D. B\u2282A"], "answer": "C", "link": "https://t.me/c/3305923058/20", "topic": "sets"}, {"chinese": "\u82e5\u96c6\u5408 A = {1, 2, 3, 4}, B = {3, 4, 5, 6}\uff0c\u5219\u4e0b\u5217\u8fd0\u7b97\u6b63\u786e\u7684\u662f", "english": "If sets A = {1, 2, 3, 4}, B = {3, 4, 5, 6}, which operation is correct?", "options": ["A. A \u222a B = {3, 4}", "B. A \u2229 B = {5, 6}", "C. A \u2229 B = {1, 2, 5, 6}", "D. A \u222a B = {1, 2, 3, 4, 5, 6}"], "answer": "D", "topic": "sets", "subtopic": "set operations", "type": "oct", "n": 2}, {"chinese": "\u4e0b\u5217\u7ed3\u8bba\u6b63\u786e\u7684\u662f", "english": "Which of the following statements is correct?", "options": ["A. -1\u2208N", "B. 3.14\u2208Q", "C. \u221a5 \u2208 Z", "D. \u03c0 + 3 \u2209 R"], "answer": "B", "topic": "sets", "type": "choice"}, {"chinese": "\u8bbe A = {6,7,8,9,10} \u662f\u4e00\u4e2a\u96c6\u5408\uff0c\u03a6 \u8868\u793a\u7a7a\u96c6\u3002\u90a3\u4e48\u4e0b\u5217\u54ea\u4e2a\u9648\u8ff0\u662f\u6b63\u786e\u7684\uff1f", "english": "Let A = {6,7,8,9,10} be a set, and \u03a6 denote the empty set. Then which of the following statements is correct?", "options": ["A. 9 \u2208 A", "B. {6} \u2208 A", "C. 6 \u2286 A", "D. \u03a6 \u2208 A"], "answer": "A", "topic": "sets", "type": "jan", "link": "https://t.me/c/3305923058/380", "n": 1}, {"chinese": "\u8bbe A = {x | -2 \u2264 x \u2264 2} \u548c B = {x | x > 0} \u662f\u4e24\u4e2a\u96c6\u5408\u3002\u90a3\u4e48 A \u222a B =", "english": "Let A = {x | -2 \u2264 x \u2264 2} and B = {x | x > 0} be two sets. Then A \u222a B =", "options": ["A. {x | x \u2264 -2}", "B. {x | 0 < x \u2264 2}", "C. {x | x \u2265 -2}", "D. {x | -2 \u2264 x < 0}"], "answer": "C", "topic": "sets", "type": "jan", "link": "https://t.me/c/3305923058/375", "n": 2}]