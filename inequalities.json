[{"chinese": "\u4e0d\u7b49\u5f0f |x+1|>5 \u7684\u89e3\u96c6\u662f\u4ec0\u4e48\uff1f", "english": "The solution set of |x+1|>5 is", "options": ["A. (4, 6)", "B. (-\u221e, -6) U (4, +\u221e)", "C. (-\u221e, -4) U (-1, +\u221e)", "D. (4, 6)"], "answer": "B", "link": "https://t.me/c/3305923058/309", "topic": "inequalities", "subtopic": "absolute value"}, {"chinese": "\u4e0d\u7b49\u5f0f |x+2|\u22643 \u7684\u89e3\u96c6\u662f\u4ec0\u4e48\uff1f", "english": "The solution set of |x+2|\u22643 is", "options": ["A. (-1,5)", "B. [-5, 1]", "C. [-1, 5]", "D. (-5, 1)"], "answer": "B", "link": "https://t.me/c/3305923058/309", "topic": "inequalities", "subtopic": "absolute value"}, {"chinese": "\u4e0d\u7b49\u5f0f |x\u22122|<3 \u7684\u89e3\u96c6\u662f\u4ec0\u4e48\uff1f", "english": "The solution set of |x\u22122|<3 is", "options": ["A. (-1,5)", "B. (-1, 5]", "C. [-1, 5]", "D. other"], "answer": "A", "link": "https://t.me/c/3305923058/309", "topic": "inequalities", "subtopic": "absolute value"}, {"chinese": "\u4e0d\u7b49\u5f0f |x-4|\u22652 \u7684\u89e3\u96c6\u4e3a", "english": "The solution set of |x-4|\u22652 is", "options": ["A. (-\u221e, 2] U [6, +\u221e)", "B. (2, 6)", "C. [2, 6]", "D. (-\u221e, 2) U (6, +\u221e)"], "answer": "A", "topic": "inequalities", "subtopic": "absolute value", "type": "extra"}, {"chinese": "\u4e0d\u7b49\u5f0f |x+3|<1 \u7684\u89e3\u96c6\u4e3a", "english": "The solution set of |x+3|<1 is", "options": ["A. (-4, -2)", "B. [-4, -2]", "C. (-\u221e, -4) U (-2, +\u221e)", "D. (-3, -1)"], "answer": "A", "topic": "inequalities", "subtopic": "absolute value", "type": "extra"}, {"chinese": "\u4e0d\u7b49\u5f0f |2x-1|\u22643 \u7684\u89e3\u96c6\u4e3a", "english": "The solution set of |2x-1|\u22643 is", "options": ["A. [-1, 2]", "B. (-1, 2)", "C. (-\u221e, -1] U [2, +\u221e)", "D. [-2, 1]"], "answer": "A", "topic": "inequalities", "subtopic": "absolute value", "type": "extra"}, {"chinese": "\u4e0d\u7b49\u5f0f |x/2-1|>3 \u7684\u89e3\u96c6\u4e3a", "english": "The solution set of |x/2-1|>3 is", "options": ["A. (-\u221e, -4) U (8, +\u221e)", "B. [-4, 8]", "C. (-4, 8)", "D. (-\u221e, -8) U (4, +\u221e)"], "answer": "A", "topic": "inequalities", "subtopic": "absolute value", "type": "extra"}, {"chinese": "\u4e0d\u7b49\u5f0f |x+1|\u2265|x-1| \u7684\u89e3\u96c6\u4e3a", "english": "The solution set of |x+1|\u2265|x-1| is", "options": ["A. (-\u221e, 0)", "B. (-\u221e, 0]", "C. [0, +\u221e)", "D. \u211d"], "answer": "C", "topic": "inequalities", "subtopic": "absolute value", "type": "extra"}, {"chinese": "\u5982\u679c a < b\uff0cc \u662f\u4efb\u610f\u5b9e\u6570\uff0c\u90a3\u4e48\uff08 \uff09", "english": "If a < b and c is any real number, then ( )", "options": ["A. ac > bc", "B. ac < bc", "C. a + c > b + c", "D. a + c < b + c"], "answer": "D", "topic": "inequalities", "type": "cq", "subtopic": "properties of inequalities"}, {"chinese": "\u5982\u679c a < b\uff0cc \u662f\u4efb\u610f\u5b9e\u6570\uff0c\u90a3\u4e48\u4e0b\u5217\u9009\u9879\u6b63\u786e\u7684\u662f\uff08 \uff09", "english": "If a < b and c is any real number, which of the following options is correct ( )", "options": ["A. a + c > b + c", "B. ac < bc", "C. -a > -b", "D. a - b > 0"], "answer": "C", "topic": "inequalities", "type": "cq", "subtopic": "properties of inequalities"}, {"chinese": "\u5982\u679c a < b\uff0c\u90a3\u4e48\u4e0b\u5217\u6b63\u786e\u7684\u662f\uff08 \uff09", "english": "If a < b, then which of the following is correct ( )", "options": ["A. -a > -b", "B. a - b > 0", "C. 1/a > 1/b", "D. a\u00b2 > b\u00b2"], "answer": "A", "topic": "inequalities", "type": "cq", "subtopic": "properties of inequalities"}, {"chinese": "\u5982\u679c a > b > 0\uff0cc \u662f\u4efb\u610f\u5b9e\u6570\uff0c\u90a3\u4e48\u4e0b\u5217\u9009\u9879\u6b63\u786e\u7684\u662f\uff08 \uff09", "english": "If a > b > 0 and c is any real number, which of the following options is correct ( )", "options": ["A. a/c > b/c", "B. 1/a > 1/b", "C. a - c < b - c", "D. a\u00b2 > b\u00b2"], "answer": "D", "topic": "inequalities", "type": "cq", "subtopic": "properties of inequalities"}, {"chinese": "\u5982\u679c a > b > 0\uff0cc \u2260 0\uff0c\u90a3\u4e48\uff08 \uff09", "english": "If a > b > 0 and c \u2260 0, then ( )", "options": ["A. a - c < b - c", "B. ac\u00b2 > bc\u00b2", "C. ac < bc", "D. a/c < b/c"], "answer": "B", "topic": "inequalities", "type": "cq", "subtopic": "properties of inequalities"}, {"chinese": "\u5982\u679c a > b\uff0cc \u662f\u4efb\u610f\u5b9e\u6570\uff0c\u90a3\u4e48\uff08 \uff09", "english": "If a > b and c is any real number, then ( )", "options": ["A. ac > bc", "B. a\u00b2 < b\u00b2", "C. a - c > b - c", "D. a + c < b + c"], "answer": "C", "topic": "inequalities", "type": "cq", "subtopic": "properties of inequalities"}, {"chinese": "\u8bbe a, b, c \u662f\u4e09\u4e2a\u5b9e\u6570\u3002\u4e0b\u5217\u54ea\u4e2a\u9648\u8ff0\u662f\u6b63\u786e\u7684\uff1f\uff08 \uff09", "english": "Let a, b, c be three real numbers. Which of the following statements is correct? ( )", "options": ["A. \u5982\u679c If a > b\uff0c\u90a3\u4e48 then ac > bc", "B. \u5982\u679c If a > b\uff0c\u90a3\u4e48 then a + c > b + c", "C. \u5982\u679c If ac > bc\uff0c\u90a3\u4e48 then a > b", "D. \u5982\u679c If a > b\uff0c\u90a3\u4e48 then a\u00b2 > b\u00b2"], "answer": "B", "topic": "inequalities", "type": "jan", "n": 22, "subtopic": "properties of inequalities"}, {"chinese": "\u82e5 a, b, c \u4e3a\u6709\u7406\u6570\uff0c\u4e14 a > b > c\uff0c\u5219\u4e0b\u5217\u5f0f\u5b50\u4e2d\u6b63\u786e\u7684\u662f", "english": "If a, b, c are rational numbers and a > b > c, which inequality is correct?", "options": ["A. a/c > b/c", "B. a + b > b + c", "C. a - b > b - c", "D. ab > bc"], "answer": "B", "topic": "inequalities", "subtopic": "properties of inequalities", "type": "oct", "n": 22}, {"chinese": "\u89e3\u4e0d\u7b49\u5f0f x\u00b2 - 5x + 6 > 0", "english": "Solve x\u00b2 - 5x + 6 > 0", "options": ["A. (-\u221e, 2) \u222a (3, \u221e)", "B. (-\u221e, 2] \u222a [3, \u221e)", "C. (2, 3)", "D. \u211d"], "answer": "A", "link": "https://t.me/c/3305923058/157", "topic": "inequalities", "subtopic": "quadratic inequalities"}, {"chinese": "\u4e0d\u7b49\u5f0f x\u00b2 + 2 x + 1  >0  \u7684\u89e3\u96c6\u662f\uff08 \uff09\u3002", "english": "The solution set of the inequality x\u00b2 + 2 x + 1  >0  is ( ).", "options": ["A. {x | x < -1  \u6216  or x > -1}", "B. {x | -1 < x < 1}", "C. {-1}", "D. {x | x \u2264 -1}"], "answer": "A", "topic": "inequalities", "subtopic": "quadratic inequalities"}, {"chinese": "\u4e0d\u7b49\u5f0f x\u00b2 + 2 x + 5  >  0  \u7684\u89e3\u96c6\u662f\uff08 \uff09\u3002", "english": "The solution set of the inequality x\u00b2 + 2 x + 4  >0  is ( ).", "options": ["A. R", "B. \u2205 ", "C. {-2}", "D. {x | x \u2264 -2}"], "answer": "A", "topic": "inequalities", "subtopic": "quadratic inequalities"}, {"chinese": "\u4e0d\u7b49\u5f0f x\u00b2 + 2 x + 5  < 0  \u7684\u89e3\u96c6\u662f\uff08 \uff09\u3002", "english": "The solution set of the inequality x\u00b2 + 2 x + 5  < 0  is ( ).", "options": ["A. R", "B. \u2205 ", "C. {-2}", "D. {x | x \u2264 -2}"], "answer": "B", "topic": "inequalities", "subtopic": "quadratic inequalities"}, {"chinese": "\u4e00\u5143\u4e8c\u6b21\u4e0d\u7b49\u5f0f x\u00b2 + 5x + 6 > 0 \u7684\u89e3\u96c6\u4e3a", "english": "The solution set of the inequality x\u00b2 + 5x + 6 > 0 is", "options": ["A. (2, 3)", "B. (-\u221e, -2] U [3, +\u221e)", "C. (-\u221e, -3) U (-2, +\u221e)", "D. (-3, -2)"], "answer": "C", "topic": "inequalities", "link": "https://t.me/c/3305923058/157", "subtopic": "quadratic inequalities"}, {"chinese": "\u4e00\u5143\u4e8c\u6b21\u4e0d\u7b49\u5f0f x\u00b2 + x - 6 > 0 \u7684\u89e3\u96c6\u4e3a", "english": "The solution set of the inequality x\u00b2 + x - 6 > 0 is", "options": ["A.  (-\u221e, -3) U (2, +\u221e)", "B. (-\u221e, -2) U (3, +\u221e)", "C. (-\u221e, -3) U (-2, +\u221e)", "D. (-3, -2)"], "answer": "A", "topic": "inequalities", "link": "https://t.me/c/3305923058/157", "subtopic": "quadratic inequalities"}, {"chinese": "\u4e0d\u7b49\u5f0f x\u00b2 - 6 x + 9 \u2264 0  \u7684\u89e3\u96c6\u662f\uff08 \uff09\u3002", "english": "The solution set of the inequality x\u00b2 - 6 x +9 \u2264 0  is ( ).", "options": ["A. {x | x < 3 \u6216 or x > 3}", "B. {x | -3 < x < 3}", "C. {3}", "D. {x | x \u2264 3}"], "answer": "C", "topic": "inequalities", "subtopic": "quadratic inequalities"}, {"chinese": "\u4e0d\u7b49\u5f0f x\u00b2 - 7x - 18 > 0 \u7684\u89e3\u96c6\u662f", "english": "The solution set of the inequality x\u00b2 - 7x - 18 > 0 is", "options": ["A. (-\u221e, -2) \u222a (9, +\u221e)", "B. (-\u221e, -2] \u222a [9, +\u221e)", "C. (-2, 9)", "D. [-2, 9]"], "topic": "inequalities", "type": "choice", "answer": "A", "subtopic": "quadratic inequalities"}, {"chinese": "\u4e00\u5143\u4e8c\u6b21\u4e0d\u7b49\u5f0f x\u00b2 - 5x + 4 < 0 \u7684\u89e3\u96c6\u4e3a", "english": "The solution set of the inequality x\u00b2 - 5x + 4 < 0 is", "options": ["A. (-4, -1)", "B. (-\u221e, 1) U (4, +\u221e)", "C. (-\u221e, -4) U (-1, +\u221e)", "D. (1, 4)"], "answer": "D", "topic": "inequalities", "type": "dec", "link": "https://t.me/c/3305923058/157", "n": 3, "subtopic": "quadratic inequalities"}, {"chinese": "\u4e0d\u7b49\u5f0f x\u00b2 - x - 2 > 0 \u7684\u89e3\u96c6\u662f\uff08 \uff09\u3002", "english": "The solution set of the inequality x\u00b2 - x - 2 > 0 is ( ).", "options": ["A. {x | x < -1 or x > 2}", "B. {x | -1 < x < 2}", "C. {x | x < -2 or x > -1}", "D. {x | -2 < x \u2264 1}"], "answer": "A", "topic": "inequalities", "link": "https://t.me/c/3305923058/375", "type": "jan", "n": 3, "subtopic": "quadratic inequalities"}, {"chinese": "\u89e3\u4e0d\u7b49\u5f0f (x - 1)/(x + 2) \u2265 0", "english": "Solve (x - 1)/(x + 2) \u2265 0", "options": ["A. (-\u221e, -2) \u222a (1, \u221e)", "B. (-\u221e, -2) \u222a [1, \u221e)", "C. (-\u221e, -2] \u222a [1, \u221e)", "D. [-2, \u221e)"], "answer": "B", "link": "https://t.me/c/3305923058/26", "topic": "inequalities", "subtopic": "rational inequalities"}, {"chinese": "\u4e0d\u7b49\u5f0f (x-1)/(x - 2) \u2264 1 \u7684\u89e3\u96c6\u4e3a", "english": "The solution set of the inequality (x-1)/(x - 2) \u2264 1  is", "options": ["A. (2, +\u221e)", "B. [1, 2]", "C. (-\u221e, 2)", "D. (-\u221e, 1]"], "answer": "C", "topic": "inequalities", "link": "https://t.me/c/3305923058/53", "type": "dec", "n": 12, "subtopic": "rational inequalities"}, {"chinese": "\u6709\u7406\u4e0d\u7b49\u5f0f (2x + 1)/(x - 2) \u2264 0 \u7684\u89e3\u96c6\u662f\uff08\uff09\u3002", "english": "The solution set of the rational inequality (2x + 1)/(x - 2) \u2264 0 is ().", "options": ["A. [-1/2, 2)", "B. (-\u221e, -1/2] \u222a (2, +\u221e)", "C. [-1/2, 2]", "D. (-\u221e, -1/2]"], "answer": "A", "topic": "inequalities", "type": "jan", "n": 12, "subtopic": "rational inequalities"}, {"chinese": "\u5206\u5f0f\u4e0d\u7b49\u5f0f (2x - 4)/(x - 1) \u2264 0 \u7684\u89e3\u96c6\u4e3a", "english": "The solution set of the fractional inequality (2x - 4)/(x - 1) \u2264 0 is", "options": ["A. {x | 1 < x \u2264 2}", "B. {x | 1 \u2264 x < 2}", "C. {x | 1 \u2264 x \u2264 2}", "D. {x | x < 1 \u6216 x > 2}"], "answer": "A", "topic": "inequalities", "subtopic": "rational inequalities", "type": "oct", "n": 11}, {"chinese": "\u5206\u5f0f\u4e0d\u7b49\u5f0f (x+1)/(x-3) > 0 \u7684\u89e3\u96c6\u4e3a", "english": "The solution set of the rational inequality (x+1)/(x-3) > 0 is", "options": ["A. (-\u221e, -1) \u222a (3, +\u221e)", "B. (-\u221e, -1] \u222a [3, +\u221e)", "C. (-1, 3)", "D. (-1, 3]"], "answer": "A", "topic": "inequalities", "subtopic": "rational inequalities", "type": "extra"}, {"chinese": "\u5206\u5f0f\u4e0d\u7b49\u5f0f (2x-3)/(x+2) \u2265 1 \u7684\u89e3\u96c6\u4e3a", "english": "The solution set of the rational inequality (2x-3)/(x+2) \u2265 1 is", "options": ["A. (-\u221e, -2) \u222a [1/3, +\u221e)", "B. (-\u221e, -2) \u222a (1/3, +\u221e)", "C. (-2, +\u221e)", "D. (-\u221e, 1/3]"], "answer": "A", "topic": "inequalities", "subtopic": "rational inequalities", "type": "extra"}, {"chinese": "\u5206\u5f0f\u4e0d\u7b49\u5f0f (x-2)/(x+1) \u2264 0 \u7684\u89e3\u96c6\u4e3a", "english": "The solution set of the rational inequality (x-2)/(x+1) \u2264 0 is", "options": ["A. (-\u221e, -1] \u222a [2, +\u221e)", "B. [-1, 2]", "C. (-1, 2]", "D. (-\u221e, -1) \u222a (2, +\u221e)"], "answer": "C", "topic": "inequalities", "subtopic": "rational inequalities", "type": "extra"}, {"chinese": "\u5206\u5f0f\u4e0d\u7b49\u5f0f (3x+2)/(x-1) < 0 \u7684\u89e3\u96c6\u4e3a", "english": "The solution set of the rational inequality (3x+2)/(x-1) < 0 is", "options": ["A. (-\u221e, -2/3) \u222a (1, +\u221e)", "B. (-2/3, 1)", "C. (-\u221e, -2/3) \u222a [1, +\u221e)", "D. (-\u221e, 1)"], "answer": "B", "topic": "inequalities", "subtopic": "rational inequalities", "type": "extra"}, {"chinese": "\u5206\u5f0f\u4e0d\u7b49\u5f0f (x+4)/(2x-1) \u2265 0 \u7684\u89e3\u96c6\u4e3a", "english": "The solution set of the rational inequality (x+4)/(2x-1) \u2265 0 is", "options": ["A. (-\u221e, -4] \u222a [1/2, +\u221e)", "B. (-4, 1/2)", "C. (-\u221e, -4) \u222a (1/2, +\u221e)", "D. [-4, 1/2]"], "answer": "A", "topic": "inequalities", "subtopic": "rational inequalities", "type": "extra"}, {"chinese": "\u5df2\u77e5 a = \u221a14 - 2\u221a3\uff0cb = 2\u221a3 - \u221a14\uff0c\u90a3\u4e48\uff08 \uff09", "english": "Given a = \u221a14 - 2\u221a3 and b = 2\u221a3 - \u221a14, then ( )", "options": ["A. a > b", "B. a < b", "C. a = b", "D. a \u2265 b"], "answer": "B", "topic": "inequalities", "type": "extra", "subtopic": "real numbers"}, {"chinese": "\u5df2\u77e5 a = \u221a5\uff0cb = 2\uff0c\u90a3\u4e48\uff08 \uff09", "english": "Given a = \u221a5 and b = 2, which of the following is correct?", "options": ["A. a > b", "B. a < b", "C. a = b", "D. a \u2264 b"], "answer": "A", "topic": "inequalities", "type": "extra", "subtopic": "real numbers"}, {"chinese": "\u5df2\u77e5 a = \u221a3\uff0cb = \u221a2\uff0c\u90a3\u4e48\uff08 \uff09", "english": "Given a = \u221a3 and b = \u221a2, which of the following is correct?", "options": ["A. a < b", "B. a = b", "C. a > b", "D. a \u2264 b"], "answer": "C", "topic": "inequalities", "type": "extra", "subtopic": "real numbers"}, {"chinese": "\u5df2\u77e5 a = 1 - \u221a2\uff0cb = -1\uff0c\u90a3\u4e48\uff08 \uff09", "english": "Given a = 1 - \u221a2 and b = -1, which of the following is correct?", "options": ["A. a > b", "B. a < b", "C. a = b", "D. a \u2265 b"], "answer": "A", "topic": "inequalities", "type": "extra", "subtopic": "real numbers"}, {"chinese": "\u5df2\u77e5 a = \u221a7 - 2\uff0cb = \u221a3\uff0c\u90a3\u4e48\uff08 \uff09", "english": "Given a = \u221a7 - 2 and b = \u221a3, which of the following is correct?", "options": ["A. a > b", "B. a < b", "C. a = b", "D. a \u2265 b"], "answer": "B", "topic": "inequalities", "type": "extra", "subtopic": "real numbers"}, {"chinese": "\u5df2\u77e5 a = 3/\u221a5\uff0cb = \u221a5/2\uff0c\u90a3\u4e48\uff08 \uff09", "english": "Given a = 3/\u221a5 and b = \u221a5/2, which of the following is correct?", "options": ["A. a > b", "B. a < b", "C. a = b", "D. a \u2264 b"], "answer": "C", "topic": "inequalities", "type": "extra", "subtopic": "real numbers"}]