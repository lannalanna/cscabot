[{"chinese": "log\u208232 + log_{1/2} 32 =", "english": "", "options": ["A. -5", "B. 10", "C. 0", "D. 5"], "answer": "C", "link": "https://t.me/c/3305923058/142", "topic": "logarithmic functions", "type": "dec", "n": 30}, {"chinese": "log\u208427 / log\u20823 =", "english": "", "options": ["A. 3/2", "B. -3/2", "C. -2/3", "D. 2/3"], "answer": "A", "topic": "logarithmic functions", "subtopic": "logarithms", "type": "oct", "link": "https://t.me/c/3305923058/169", "n": 28}, {"chinese": "\u5df2\u77e5 a = ln 3, b = log_{0.3} 2, c = log_3 2\uff0c\u5219 a, b, c \u7684\u5927\u5c0f\u5173\u7cfb\u662f", "english": "Given a = ln 3, b = log_{0.3} 2, c = log_3 2, then the order of a, b, c is", "options": ["A. a < c < b", "B. c < a < b", "C. a < b < c", "D. b < c < a"], "answer": "D", "topic": "logarithmic functions", "subtopic": "logarithms", "type": "oct", "n": 42}, {"chinese": "\u8bbe a > 0, b > 0 \u4e3a\u5b9e\u6570\u3002\u90a3\u4e48\u4e0b\u5217\u54ea\u4e2a\u9648\u8ff0\u662f\u4e0d\u6b63\u786e\u7684\uff1f\uff08 \uff09", "english": "Let a > 0, and b > 0 be real numbers. Then which of the following statements is incorrect? ( )", "options": ["A. ln(a\u1d47) = b ln a", "B. log\u2090 b = ln a / ln b (a\u22601, b\u22601)", "C. ln(a/b) = ln a - ln b", "D. ln(ab) = ln a + ln b"], "answer": "B", "topic": "logarithmic functions", "type": "jan", "n": 29}]