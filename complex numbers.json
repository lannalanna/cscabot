[{"chinese": "\u82e5\u590d\u6570z\u6ee1\u8db3 z\u00b3 = 1 \u4e14 z \u2260 1\uff0c\u5219 1 + z + z\u00b2 + ... + z\u2079\u2079\u2079 =", "english": "If the complex number z satisfies z\u00b3 = 1 and z \u2260 1, then 1 + z + z\u00b2 + ... + z\u2079\u2079\u2079 =", "options": ["A. (1 \u00b1 \u221a3i)/2", "B. (-1 \u00b1\u221a3i)/2", "C. 1", "D. i"], "answer": "C", "topic": "complex numbers", "type": "dec", "n": 47, "subtopic": "complex numbers"}, {"chinese": "\u5728\u590d\u5e73\u9762\u4e0a\uff0c\u8868\u793a\u590d\u6570 z \u7684\u70b9\u5728\u76f4\u7ebf x - y = 0 \u4e0a\u3002\u5982\u679c z \u662f\u4e8c\u6b21\u65b9\u7a0b x\u00b2 + mx + 4 = 0 \u7684\u4e00\u4e2a\u6839\uff0c\u90a3\u4e48 m = ( )\u3002", "english": "On the complex plane, the point representing a complex number z is on the straight line x - y = 0. If z is a root of a quadratic equation x\u00b2 + mx + 4 = 0, then m = ( ).", "options": ["A. \u221a2 \u6216 or 2\u221a2", "B. 2\u221a2 \u6216 or -2\u221a2", "C. -\u221a2 \u6216 or -2\u221a2", "D. \u221a2 \u6216 or -\u221a2"], "answer": "B", "topic": "complex numbers", "type": "jan", "n": 46, "subtopic": "complex numbers"}, {"chinese": "(1+i)\u00b2 =", "english": "", "options": ["A. 1", "B. i", "C. -1", "D. 2i"], "answer": "D", "topic": "complex numbers", "type": "moc", "subtopic": "complex numbers"}, {"chinese": "\u5df2\u77e5\u590d\u6570 z = -1 + i\uff0c\u5219 |z| =", "english": "For z = -1 + i, |z| =", "options": ["A. 1", "B. \u221a2", "C. \u221a3", "D. 2"], "answer": "B", "topic": "complex numbers", "type": "moc", "subtopic": "complex numbers"}, {"chinese": "\u5df2\u77e5\u590d\u6570 z = 1 + i\u221a3\uff0c\u5219 |z| =", "english": "For z = 1 + i\u221a3, |z| =", "options": ["A. \u221a2", "B. 2", "C. \u221a3", "D. 3"], "answer": "B", "topic": "complex numbers", "type": "moc", "subtopic": "complex numbers"}, {"chinese": "\u590d\u6570 z = 1 + i\u221a3 \u7684\u4e09\u89d2\u5f62\u5f0f\u4e3a", "english": "The polar form of z = 1 + i\u221a3 is", "options": ["A. 2(cos(\u03c0/3) + i sin(\u03c0/3))", "B. 2(cos(\u03c0/6) + i sin(\u03c0/6))", "C. 2(cos(2\u03c0/3) + i sin(2\u03c0/3))", "D. cos(\u03c0/3) + i sin(\u03c0/3)"], "answer": "A", "topic": "complex numbers", "type": "moc", "subtopic": "complex numbers"}, {"chinese": "\u5df2\u77e5\u590d\u6570 |z| = 1\uff0c\u5219 |2z + 1| \u7684\u6700\u5927\u503c\u4e3a", "english": "Given complex number |z| = 1, then the maximum value of |2z + 1| is", "options": ["A. 2", "B. 1", "C. 5/2", "D. 3"], "answer": "D", "topic": "complex numbers", "subtopic": "complex numbers", "type": "oct", "n": 46}]